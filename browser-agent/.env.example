# Copy this file to .env. Never commit the real .env file.
# Keep all local services bound to 127.0.0.1 unless you later add authenticated access.

GEED_APP_URL=https://geed-hardwin.vercel.app/
GEED_CDP_URL=http://127.0.0.1:9222
GEED_ALLOWED_DOMAINS=geed-hardwin.vercel.app
GEED_LITELLM_URL=http://127.0.0.1:4000/v1
GEED_LLM_MODEL=geed-agent
LITELLM_MASTER_KEY=sk-geed-change-this-before-starting
GEED_AGENT_DB=./data/geed-agent.sqlite
GEED_CHECKPOINT_DB=./data/geed-workflow.sqlite

# Local model. Start Ollama and run: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b

# Add provider API keys only when you choose to connect them.
# LiteLLM routes rate-limit/provider failures through the fallback chain.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Use a model ID supported by the provider and your account.
# Examples below are placeholders; replace with model IDs enabled for your keys.
GEED_OPENAI_MODEL=openai/gpt-4.1-mini
GEED_ANTHROPIC_MODEL=anthropic/claude-3-5-haiku-latest
GEED_GEMINI_MODEL=gemini/gemini-2.5-flash
